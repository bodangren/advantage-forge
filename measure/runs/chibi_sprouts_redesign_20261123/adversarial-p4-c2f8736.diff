+    return fail('palm faces away from the body');
+
+  return {
+    ok: true,
+    normal: d,
+    sideDot,
+    patchArea,
+    agreement,
+    palmContact,
+    thumbContact,
+    thumbOut,
+    thumbForward,
+  };
+}
