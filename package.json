{
  "name": "fantasy-asset-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <25"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "lint": "eslint . && dependency-cruiser src --config dependency-cruiser.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "generate": "node scripts/generate-architecture.mjs",
    "doctor": "bash measure/doctor.sh",
    "mcp": "node --import tsx src/mcp/stdio.ts",
    "reference:build": "node --import tsx scripts/build-references.ts",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm generate && git diff --exit-code -- measure/generated && pnpm doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/three": "0.185.1",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "tsx": "4.20.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
